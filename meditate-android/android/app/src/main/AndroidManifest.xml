<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written replacement for xbuild's quick_xml-serialized
     manifest. Two things xbuild could NOT emit and we now state
     explicitly:
       1. The <activity android:name="android.app.NativeActivity">
          + android.app.lib_name meta-data. xbuild emitted NO
          <activity> at all; slint's android-activity glue worked
          implicitly. A hand-written manifest MUST declare it.
          lib_name = the cdylib soname without lib/.so prefix
          (libmeditate_android.so -> "meditate_android"); it is
          also load-bearing for the JNI app-classloader dotted
          path in service.rs.
       2. android:hasCode="true" — NDK NativeActivity normally
          uses hasCode="false", but we ship Kotlin (the
          foreground service + audio/haptics JNI helpers); with
          false the app classloader's DexPathList is empty and
          every loadClass for our classes throws
          ClassNotFoundException (the exact crash documented in
          the old manifest.yaml). KEEP true.
     applicationId / SDK levels / version live in build.gradle
     (AGP 7.3 `namespace`), so this manifest carries no
     package=/uses-sdk. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOREGROUND_SERVICE since API 28; the mediaPlayback
         per-type permission is mandatory on API 34+ or the
         service start throws SecurityException. POST_NOTIFICATIONS
         is the API 33+ runtime prompt. VIBRATE is install-time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Partial wake lock while a session runs so the 200 ms tick
         keeps firing under Doze and bells ring on time; released
         the moment the session ends. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Phase 7 sync: core's ureq orchestrator talks WebDAV to the
         user's Nextcloud. Install-time, no runtime prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No cloud/D2D backup: the DB restores wrong (Keystore-
         encrypted sync secret can't decrypt on another device) and
         Nextcloud sync + CSV export are the real backup story.
         Session notes are personal data; keep them off transports
         the user never chose. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:theme="@style/Theme.Meditate">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="meditate_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the timer alive across screen-off/app-switch.
             Not exported — only this app binds it. -->
        <service
            android:name=".MeditateSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Guided-mode SAF picker shim (Phase 6.5). Owns the
             ACTION_OPEN_DOCUMENT request/result because
             NativeActivity can't receive onActivityResult; hands
             the pick back via a drop-file. Translucent + no UI of
             its own (the system picker is the only visible UI),
             not exported, kept out of recents. -->
        <activity
            android:name=".MeditateFilePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Starred-preset home-screen widget (W-series).
             exported=true is mandatory: the launcher / system
             AppWidgetHost sends the APPWIDGET_UPDATE broadcast
             from outside the app, and API 31+ rejects an
             unexported receiver that carries an intent-filter. -->
        <receiver
            android:name=".MeditateWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider" />
        </receiver>

        <!-- Backs R.id.widget_list. BIND_REMOTEVIEWS is the
             system-held permission that lets only the platform
             AppWidget host bind it; not launchable by other apps. -->
        <service
            android:name=".MeditateWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>
