<?xml version="1.0" encoding="utf-8"?>
<!-- Per-row card behind a starred preset (@color/widget_row_bg):
     below Android 12 a faint white wash over the slate, on 12+ the
     system's secondary container; 12dp corners (a touch tighter than the
     16dp outer card) so the rows nest like the mockup. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_row_bg" />
    <corners android:radius="12dp" />
</shape>
