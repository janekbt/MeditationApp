<?xml version="1.0" encoding="utf-8"?>
<!-- The lotus mark from the GTK app icon
     (meditate-gtk/.../io.github.janekbt.Meditate.svg), petals
     only — no squircle background, pure white so it reads on the
     widget's slate card. 5 petals converging at (64,92), drawn
     back-to-front (outer → inner → centre) so the centre petal
     sits on top, exactly like the SVG. SVG `rotate(d 64 92)`
     maps to a <group> with matching pivot. Strokes dropped: the
     SVG's faint blue outline is invisible at widget size.
     128×128 viewport matches the source icon's coordinate space. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Outer petals -->
    <group android:rotation="-55" android:pivotX="64" android:pivotY="92">
        <path android:fillColor="#FFFFFF"
            android:pathData="M64,92 C50,84 50,62 64,44 C78,62 78,84 64,92 Z" />
    </group>
    <group android:rotation="55" android:pivotX="64" android:pivotY="92">
        <path android:fillColor="#FFFFFF"
            android:pathData="M64,92 C50,84 50,62 64,44 C78,62 78,84 64,92 Z" />
    </group>

    <!-- Inner side petals -->
    <group android:rotation="-30" android:pivotX="64" android:pivotY="92">
        <path android:fillColor="#FFFFFF"
            android:pathData="M64,92 C46,80 46,50 64,30 C82,50 82,80 64,92 Z" />
    </group>
    <group android:rotation="30" android:pivotX="64" android:pivotY="92">
        <path android:fillColor="#FFFFFF"
            android:pathData="M64,92 C46,80 46,50 64,30 C82,50 82,80 64,92 Z" />
    </group>

    <!-- Centre petal (frontmost) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M64,92 C46,80 46,50 64,30 C82,50 82,80 64,92 Z" />
</vector>
