<?xml version="1.0" encoding="utf-8"?>
<!-- Widget chrome: titled card whose body is the preset
     collection. The empty TextView is wired via setEmptyView so
     it shows only when the factory yields zero rows (no starred
     presets / projection not written yet). RemoteViews supports
     only this small layout/widget vocabulary — LinearLayout +
     ListView + TextView is the whole toolbox. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Header row: title (tap → open app) on the left, the app
         icon's white lotus pinned top-right. center_vertical so
         the glyph aligns with the title baseline-ish. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meditate"
            android:textColor="@color/widget_fg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_lotus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/widget_app_icon"
            android:contentDescription="@null" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No starred presets"
        android:textColor="@color/widget_fg_muted"
        android:textSize="13sp" />

    <!-- Transparent divider = the gap between the row cards
         (AbsListView ignores item layout_margin, so spacing is
         done here). -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

</LinearLayout>
