<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget palette from the system colours (Android 12+), the
         tones Android's own widgets use. Dark mode: values-night-v31. -->
    <color name="widget_bg">@android:color/system_neutral1_50</color>
    <color name="widget_fg">@android:color/system_neutral1_900</color>
    <color name="widget_fg_muted">@android:color/system_neutral2_700</color>
    <color name="widget_row_bg">@android:color/system_accent2_100</color>
    <!-- App image: the accent at the icon blue's brightness, the
         same in dark mode (no night override). -->
    <color name="widget_icon_top">@android:color/system_accent1_400</color>
    <color name="widget_icon_bottom">@android:color/system_accent1_600</color>
</resources>
