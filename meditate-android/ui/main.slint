// UI translation Phase 1 — Setup + Timer running view. Mirrors the
// GTK timer setup page (`meditate-gtk/data/ui/timer_view.blp`) and
// the running page built in `meditate-gtk/src/window/imp.rs`.
//
// Setup: hero showing the configured duration, hours/minutes stepper
// rows, Start button. Running: hero showing live remaining time,
// Pause / Stop / Add-time / Finish-overtime.
//
// Phase 2 will add the mode chip group + per-mode stopwatch toggle;
// phase 3 wires the streak chip + label / preset rows to the DB.

import { FilledButton, OutlineButton, TonalButton } from "@material";
export { MaterialWindowAdapter } from "@material";

// Stepper row mirroring the GTK shell's AdwSpinRow shape: title on
// the left, decrement / value / increment on the right. The Slint
// Material library doesn't ship a SpinBox, so this is the smallest
// touch-friendly equivalent — large +/- TonalButtons flanking a
// big-font value text.
component StepperRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> min-value;
    in property <int> max-value;

    spacing: 12px;
    alignment: stretch;

    Text {
        text: root.label;
        font-size: 16px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        TonalButton {
            text: "−";
            enabled: root.value > root.min-value;
            clicked => {
                if (root.value > root.min-value) { root.value -= 1; }
            }
        }

        Text {
            text: root.value;
            font-size: 28px;
            horizontal-alignment: center;
            vertical-alignment: center;
            min-width: 56px;
        }

        TonalButton {
            text: "+";
            enabled: root.value < root.max-value;
            clicked => {
                if (root.value < root.max-value) { root.value += 1; }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Meditate";

    // The big mm:ss readout, formatted in Rust (handles ceiling
    // rounding so a fresh "10:00" doesn't briefly flicker to "09:59").
    in property <string> remaining-text: "00:00";
    // Primary action button label: "Start Session" / "Pause" / "Resume".
    in property <string> action-label: "Start Session";
    // True once the session has started — switches between the
    // setup-page chrome (caption + single button) and the running-page
    // chrome (Pause + Stop). Idle is the only state that hides Stop.
    in property <bool> running-page: false;
    // Stop is visible whenever the user has something to stop —
    // Running, Paused, or Finished (so they can reset the screen).
    in property <bool> stop-visible: false;

    // Duration picker state. Hours capped at 3 (matches the GTK
    // shell's spin-row upper bound); minutes 0–59. Rust reads these
    // on Start to compute the session target.
    in-out property <int> setup-hours: 0;
    in-out property <int> setup-minutes: 10;

    callback action-tap();
    callback stop-tap();

    VerticalLayout {
        padding: 24px;
        spacing: 24px;
        alignment: center;

        // Hero: streak chip placeholder + big mm:ss + caption.
        // Streak chip is empty in phase 1 (DB integration arrives in
        // phase 3); kept in the layout so the spacing matches the GTK
        // setup-page hero the moment streaks land.
        VerticalLayout {
            alignment: center;
            spacing: 4px;

            if !running-page : Text {
                text: "";
                font-size: 14px;
                horizontal-alignment: center;
            }

            Text {
                text: remaining-text;
                font-size: 80px;
                horizontal-alignment: center;
            }

            if !running-page : Text {
                text: "Hours · Minutes";
                font-size: 12px;
                color: #888;
                horizontal-alignment: center;
            }
        }

        // Duration picker — visible only on the setup page. The
        // hero above reflects the steppers in real time so the user
        // can see the resulting mm:ss as they adjust.
        if !running-page : VerticalLayout {
            spacing: 8px;

            StepperRow {
                label: "Hours";
                value <=> setup-hours;
                min-value: 0;
                max-value: 3;
            }
            StepperRow {
                label: "Minutes";
                value <=> setup-minutes;
                min-value: 0;
                max-value: 59;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            FilledButton {
                text: action-label;
                enabled: running-page || (setup-hours > 0 || setup-minutes > 0);
                clicked => { action-tap(); }
            }

            if stop-visible : OutlineButton {
                text: "Stop";
                clicked => { stop-tap(); }
            }
        }
    }
}
