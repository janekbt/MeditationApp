// UI translation Phase 1 — Setup + Timer running view. Mirrors the
// GTK timer setup page (`meditate-gtk/data/ui/timer_view.blp`) +
// the running page built by `meditate-gtk/src/window/imp.rs::
// push_time_running_page`. The slide-over transition mirrors
// `AdwNavigationView`'s push: Setup stays put at x=0 while the
// Running screen slides over it from the right. Reverse on Stop:
// Running slides back off to the right, revealing Setup underneath.
// The Duration row's tap-to-open dialog mirrors
// `show_custom_time_dialog` in `meditate-gtk/src/timer/imp.rs`.

import {
    FilledButton, OutlineButton, TextButton, TonalButton,
    SegmentedButton, Switch, IconButton, TextField, NavigationBar,
    MaterialPalette,
    DatePickerPopup, DatePickerAdapter,
    TimePickerPopup, Time,
    DropDownMenu,
    CircularProgressIndicator,
} from "@material";
// `MenuItem` (DropDownMenu's `items` element type) isn't
// re-exported through `material.slint`; pull it from the source
// module so the Log-filter label dropdown can be typed.
import { MenuItem } from "../material-1.0/ui/items/menu_item.slint";
// `Date` isn't re-exported through `material.slint` (unlike its
// sibling `Time`); import it directly from the picker module so
// `edit-start-date` and the popup's `accepted(date)` callback can
// type-check.
import { Date } from "../material-1.0/ui/components/date_picker.slint";
// Icons aren't re-exported through the `@material` alias the
// Material library registers; import the global directly so the
// chooser's check + back-arrow can render proper SVGs instead of
// fallback Unicode glyphs (the system font on Android 15 doesn't
// carry ✓, which rendered as a tofu box).
import { Icons } from "../material-1.0/ui/icons/icons.slint";
export { MaterialWindowAdapter, DatePickerAdapter } from "@material";

// One session card row in the Log feed. Mirrors GTK's
// `build_card` content (`meditate-gtk/src/log/imp.rs:362`):
// duration in minutes + time-of-day on the left, label chip +
// note on the right.
export struct LogCardItem {
    id: int,
    minutes: int,
    time-of-day: string,
    label-name: string,
    note: string,
    // Stable 0..7 colour-class index for the label name from
    // `meditate_core::format::label_color_class_index`; -1 when
    // the session has no label (Slint maps that to a dim grey
    // stripe, mirroring GTK's `log-c-none` fallback).
    color-index: int,
}

// One date section in the Log feed — a header (date + dimmed
// count / total caption) plus the cards for that day. Built in
// Rust via `build_section_frame` in the GTK shell; here Slint
// renders the same shape via a `for section in log-sections`
// inside the Log page.
export struct LogDaySection {
    date-display: string,
    caption: string,
    items: [LogCardItem],
}

// Row data for the Label chooser overlay screen. `id` is the
// local DB rowid (matches `meditate_core::db::Label::id` and is
// what `Session::from_unix` ultimately stores as label_id);
// `selected` is the row that gets the check-mark suffix —
// mirrors GTK's `object-select-symbolic` indicator on the row
// matching `setup_selected_label_id`.
export struct LabelItem {
    id: int,
    name: string,
    selected: bool,
}

// Multi-line note input — the Slint Material library's `TextField`
// is hard-coded `single_line: true`, but the GTK shell's note view
// is a 180-px-tall Gtk.TextView with word-wrap. This custom
// component reproduces the Material 3 filled-text-field look
// (rounded surface-container-highest with an active-indicator bar
// under the input) while letting the user type multiple lines.
component NoteField inherits Rectangle {
    in property <string> label: "Note";
    in-out property <string> text <=> input.text;

    // Starts at a single-line height; the inner TextInput's
    // `preferred-height` grows with every wrapped line, and because
    // nothing in the layout caps the Rectangle, the box auto-expands
    // line by line as the user types. Word-wrap on TextInput is what
    // turns long pasted text into more lines instead of one runaway
    // horizontal scroll.
    min-height: 56px;
    border-radius: 12px;
    background: MaterialPalette.surface-container-highest;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;

        Text {
            text: root.label;
            font-size: 12px;
            color: input.has-focus
                ? MaterialPalette.primary
                : MaterialPalette.on-surface-variant;
        }

        input := TextInput {
            single-line: false;
            wrap: word-wrap;
            font-size: 16px;
            color: MaterialPalette.on-surface;
            selection-background-color: MaterialPalette.primary;
            selection-foreground-color: MaterialPalette.on-primary;
            vertical-alignment: top;
        }
    }

    // Active-indicator strip along the bottom — primary color
    // while focused, on-surface-variant otherwise. Mirrors the
    // Material 3 filled-text-field state.
    Rectangle {
        y: parent.height - self.height;
        height: input.has-focus ? 3px : 1px;
        background: input.has-focus
            ? MaterialPalette.primary
            : MaterialPalette.on-surface-variant;
    }
}

// Vertical +/value/− stack mirroring the GTK shell's vertical
// `gtk::SpinButton`. Used inside the Duration dialog.
component VerticalSpinBox {
    in-out property <int> value;
    in property <int> min-value;
    in property <int> max-value;
    width: 80px;

    VerticalLayout {
        spacing: 6px;
        alignment: center;

        TonalButton {
            text: "+";
            enabled: root.value < root.max-value;
            clicked => {
                if (root.value < root.max-value) { root.value += 1; }
            }
        }
        Text {
            text: root.value < 10 ? "0" + root.value : "" + root.value;
            font-size: 32px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TonalButton {
            text: "−";
            enabled: root.value > root.min-value;
            clicked => {
                if (root.value > root.min-value) { root.value -= 1; }
            }
        }
    }
}

// Single tap-to-open Duration row, mirroring the GTK Adw.ActionRow
// with title + value suffix + chevron. The whole row is the touch
// target. The default `label` keeps existing callers (Setup
// screen's Duration row) compiling unchanged; the Edit-Session
// overlay overrides it to render Date / Time rows with the same
// shape.
component DurationRow inherits Rectangle {
    in property <string> label: "Duration";
    in property <string> value-text;
    in property <bool> enabled: true;
    callback tapped;

    height: 56px;
    // Rows live inside a BoxedList container that owns the rounded
    // surface — they paint a transparent base and only darken on
    // hover for the touch affordance. Disabled state is just the
    // overall opacity drop. Mirrors GTK's `boxed-list` styling
    // where individual `Adw.ActionRow` rows don't carry their own
    // background, only the parent `Adw.PreferencesGroup` does.
    background: !root.enabled
        ? transparent
        : (touch.has-hover ? MaterialPalette.surface-container-high
                           : transparent);
    opacity: root.enabled ? 1.0 : MaterialPalette.disable-opacity;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.tapped(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;

        Text {
            text: root.label;
            font-size: 16px;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value-text;
            font-size: 16px;
            color: MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }
        Text {
            text: "›";
            font-size: 22px;
            color: MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }
    }
}

// Adw.SwitchRow analogue — title + subtitle on the left, suffix
// Switch on the right. Mirrors `stopwatch_mode_row` shape in the
// .blp (title "Stopwatch Mode", subtitle "Count up from zero").
// Background is transparent because the parent BoxedList owns the
// rounded surface, mirroring GTK's boxed-list pattern.
component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in-out property <bool> checked;
    callback toggled(bool);

    height: 64px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-size: 16px;
                color: MaterialPalette.on-surface;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: 12px;
                color: MaterialPalette.on-surface-variant;
            }
        }
        // Material's stock Switch dimensions are 52×32. The fixed-
        // size Rectangle wrapper is what stops the HorizontalLayout
        // from stretching the Switch vertically to fill the 64-px
        // row — without the wrapper, the Switch grows to row
        // height and the indicator ball balloons (since the inner
        // geometry is proportional to `self.height`). VerticalLayout
        // alignment: center keeps the toggle centered in the row.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 32px;
                Switch {
                    min-width: 52px;
                    min-height: 32px;
                    checked <=> root.checked;
                    checked-state-changed(value) => { root.toggled(value); }
                }
            }
        }
    }
}

// Compact 3-option toggle, sized to fit inline alongside an
// action-row title without overflowing the row. Material's stock
// `SegmentedButton` hard-codes 24 px horizontal padding per item
// (plus a check-mark on the selected item), which made the GTK
// labels "Sound / Vibration / Both" run past the BoxedList edge.
// This component uses 10 px padding and no check-mark, keeping
// the chip group narrow enough to sit inside the row.
component CompactToggle inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> current-index;
    callback changed(int);

    height: 32px;
    border-radius: 16px;
    border-width: 1px;
    border-color: MaterialPalette.outline;
    clip: true;

    HorizontalLayout {
        spacing: 0;
        for label[idx] in root.labels : Rectangle {
            background: idx == root.current-index
                ? MaterialPalette.secondary-container
                : transparent;

            TouchArea {
                clicked => {
                    root.current-index = idx;
                    root.changed(idx);
                }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: label;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: MaterialPalette.on-surface;
                }
            }

            // Hair-line divider between items, mirroring the
            // stock Material SegmentedButton's interior outline.
            // Skipped after the last item.
            if idx < root.labels.length - 1 : Rectangle {
                x: parent.width - self.width;
                width: 1px;
                height: 100%;
                background: MaterialPalette.outline;
            }
        }
    }
}

// Adw.ActionRow-with-segmented-suffix analogue — title on the
// left, inline three-option chip group on the right. Mirrors the
// .blp `cues_signal_mode_row` (the GTK shell builds an
// `Adw.ToggleGroup` programmatically in Rust; here Slint owns the
// chip group directly so the .slint stays declarative).
component CuesRow inherits Rectangle {
    in property <string> title;
    in-out property <int> current-index;
    callback changed(int);

    height: 64px;
    background: transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 16px;
                color: MaterialPalette.on-surface;
            }
        }
        VerticalLayout {
            alignment: center;
            CompactToggle {
                labels: ["Sound", "Vibration", "Both"];
                current-index <=> root.current-index;
                changed(idx) => { root.changed(idx); }
            }
        }
    }
}

// Adw.ExpanderRow analogue — header with title + subtitle +
// master switch, and an inner row that reveals when the switch
// is on. Mirrors the .blp `setup_label_enabled_row`: master
// toggle gates the "expansion body" (a single Adw.ActionRow
// titled "Selected" with the current label name as subtitle).
// Tapping the inner row will (in the next slice) push a label-
// chooser navigation page; for now the body-tap callback is a
// no-op stub so the surface is complete.
component ExpanderRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> body-title;
    in property <string> body-subtitle;
    in-out property <bool> active;
    callback toggled(bool);
    callback body-tapped();

    background: transparent;

    VerticalLayout {
        spacing: 0;

        // Header row — same metrics as SwitchRow.
        Rectangle {
            height: 64px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.title;
                        font-size: 16px;
                        color: MaterialPalette.on-surface;
                    }
                    if root.subtitle != "" : Text {
                        text: root.subtitle;
                        font-size: 12px;
                        color: MaterialPalette.on-surface-variant;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 32px;
                        Switch {
                            min-width: 52px;
                            min-height: 32px;
                            checked <=> root.active;
                            checked-state-changed(value) => { root.toggled(value); }
                        }
                    }
                }
            }
        }

        // Hair-line divider — always rendered, height animates
        // between 0 and 1 px alongside the body. Without the
        // animation the divider would pop in/out a frame ahead of
        // the body slide.
        Rectangle {
            height: root.active ? 1px : 0px;
            background: MaterialPalette.outline-variant;
            clip: true;
            animate height {
                duration: 250ms;
                easing: ease-in-out;
            }
        }

        // Inner "Selected" row — mirrors the .blp
        // `setup_label_chooser_row`. Always rendered so the slide-
        // in/out can animate `height` between 56 px and 0 (Slint
        // can't animate the appearance of an `if`-gated element).
        // `clip: true` hides the inner content while collapsed.
        Rectangle {
            height: root.active ? 56px : 0px;
            background: body-touch.has-hover && root.active
                ? MaterialPalette.surface-container-high
                : transparent;
            clip: true;
            animate height {
                duration: 250ms;
                easing: ease-in-out;
            }

            body-touch := TouchArea {
                enabled: root.active;
                clicked => { root.body-tapped(); }
            }

            HorizontalLayout {
                padding-left: 32px;
                padding-right: 16px;
                spacing: 12px;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.body-title;
                        font-size: 14px;
                        color: MaterialPalette.on-surface;
                    }
                    if root.body-subtitle != "" : Text {
                        text: root.body-subtitle;
                        font-size: 12px;
                        color: MaterialPalette.on-surface-variant;
                    }
                }
                Text {
                    text: "›";
                    font-size: 22px;
                    color: MaterialPalette.on-surface-variant;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Box-Breath phase tile — one cell of the Setup view's 2×2
// phase grid. Mirrors GTK's `build_phase_tile`
// (`meditate-gtk/src/timer/imp.rs:4080-4153`): a small card with
// the phase title on top + a `−  Ns  +` stepper below. Steppers
// use TonalButton with "−" / "+" glyphs instead of Material
// icons (the bundled Icons set has no "add" SVG).
component PhaseTile inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <int> seconds;
    in property <int> min-seconds;
    in property <int> index;
    callback adjust(int, int);

    height: 96px;
    border-radius: 12px;
    background: MaterialPalette.surface-container;

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: stretch;

        // Top row: icon + title — mirrors GTK's `build_phase_tile`
        // head box (`imp.rs:4094-4111`), which places a 16 px
        // accent-tinted icon to the left of a caption-dimmed
        // title label.
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Image {
                source: root.icon;
                colorize: MaterialPalette.primary;
                width: 16px;
                height: 16px;
            }
            Text {
                text: root.title;
                font-size: 12px;
                color: MaterialPalette.on-surface-variant;
                vertical-alignment: center;
                horizontal-stretch: 1;
                horizontal-alignment: left;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            // Steppers wrapped in fixed-size Rectangles to stop
            // Material's default ~64 px button width from pushing
            // the two-column grid past the screen edge. 36×36 is
            // small enough to fit two tiles in a 360 dp phone, big
            // enough for a comfortable touch target.
            Rectangle {
                width: 36px;
                height: 36px;
                TonalButton {
                    text: "−";
                    enabled: root.seconds > root.min-seconds;
                    clicked => { root.adjust(root.index, -1); }
                }
            }
            Text {
                text: root.seconds + "s";
                font-size: 22px;
                width: 44px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: MaterialPalette.on-surface;
            }
            Rectangle {
                width: 36px;
                height: 36px;
                TonalButton {
                    // PHASE_MAX_SECS = 20 in meditate_core::breath;
                    // the shell-side max stays as a literal here
                    // (Slint can't import const values from Rust).
                    text: "+";
                    enabled: root.seconds < 20;
                    clicked => { root.adjust(root.index, 1); }
                }
            }
        }
    }
}

// Boxed-list container — mirrors GTK's `Adw.PreferencesGroup`
// boxed-list look: a single rounded surface that visually wraps
// its child rows, with 1 px dividers between them and no
// per-row background. Slint's `@children` lets callers pass in
// any mix of SwitchRow / DurationRow / future Adw-row analogues;
// `clip: true` keeps the rounded corners crisp over row hover
// states that would otherwise paint over the corner radius.
component BoxedList inherits Rectangle {
    border-radius: 16px;
    background: MaterialPalette.surface-container;
    clip: true;

    VerticalLayout {
        spacing: 0;
        @children
    }
}

export component MainWindow inherits Window {
    title: "Meditate";

    in property <string> remaining-text: "00:10";
    in property <string> duration-text: "00:10";
    in property <string> action-label: "Start Session";
    in property <bool> running-page: false;
    in property <bool> stop-visible: false;
    // Streak chip slot above the hero — matches `streak_label` in
    // `meditate-gtk/data/ui/timer_view.blp` (line 32). Empty
    // placeholder for now; phase 3 wires the real value from the
    // DB. Defined as a property rather than a hard-coded blank
    // Text so the layout doesn't reshape once phase 3 fills it in.
    in property <string> streak-text: "";
    // Done screen: replaces Setup as the base layer while it's up.
    // running-page may also be true briefly during the transition
    // (Done is set first, then running-page is cleared so the
    // overlay slides off to the right, revealing Done underneath).
    in property <bool> done-page: false;
    // Elapsed time the user actually meditated, formatted MM:SS or
    // HH:MM:SS by the Rust side. Shown big at the top of Done.
    in property <string> elapsed-text: "00:00";

    in-out property <int> setup-hours: 0;
    in-out property <int> setup-minutes: 10;

    // Mode chip group selection — 0=Timer, 1=Guided, 2=Box Breath.
    // Mirrors the .blp `mode_toggle_group` toggle order. Rust echoes
    // this back on launch (defaults to Timer); user taps update it
    // via the `mode-changed` callback so we can refresh dependent
    // surfaces (Start enabled / Setup body / persisted mode).
    in-out property <int> setup-mode: 0;

    // Stopwatch-Mode switch state — mirrors the .blp
    // `stopwatch_mode_row` SwitchRow. When true, sessions count up
    // from zero with no target (SessionShape::TimerStopwatch);
    // Duration row gets greyed; Start enables regardless of the
    // configured hours/minutes. Visible in Timer mode only, same as
    // GTK's per-mode visibility rule.
    in-out property <bool> stopwatch-on: false;

    // Keep-Screen-Awake switch state — mirrors the .blp
    // `keep_screen_awake_row` SwitchRow. Per-mode value persisted
    // in the DB via `settings_keys::keep_screen_awake_key_for_mode`;
    // Rust reads it on launch + on each mode chip flip, writes on
    // toggle. Real WakeLock acquisition lands in platform-edge
    // phase 8 (Android `Window.FLAG_KEEP_SCREEN_ON` / PowerManager).
    in-out property <bool> keep-awake-on: false;

    // Cues per-mode signal toggle — mirrors the .blp
    // `cues_signal_mode_row` (the toggle group is built in Rust
    // for GTK; here Slint owns the SegmentedButton directly).
    // Index encoding: 0=Sound, 1=Vibration, 2=Both, matching the
    // GTK toggle order. Per-mode value persisted via
    // `settings_keys::signal_mode_key_for_mode`. Default is Both
    // (matches `clamp_signal_mode_for_haptic`'s default branch).
    // Audio + haptic playback land in platform-edge phase 5;
    // this slice is surface + persisted preference only.
    in-out property <int> cues-mode: 2;

    // Label expander master switch — mirrors the .blp
    // `setup_label_enabled_row` (Adw.ExpanderRow with
    // show-enable-switch: true). When on, the inner Selected row
    // shows the resolved label name; when off, the row collapses
    // and Save commits the session without a label. Per-mode
    // persistence via `meditate_core::labels::persist_active_for_mode`.
    in-out property <bool> label-active: false;
    // Resolved label name to display inside the expander when
    // `label-active` is true. Rust fills this from
    // `meditate_core::labels::resolve_label_for_mode` on launch +
    // mode flip; the chooser screen lets the user override it.
    in property <string> label-name: "";

    // Label chooser overlay visibility — driven by the Rust side
    // when the user taps the ExpanderRow's inner Selected row.
    // Same slide-from-right pattern as Running / Done; mirrors
    // GTK's AdwNavigationView push of `push_labels_chooser`.
    in property <bool> labels-page: false;

    // Rows displayed in the chooser. Rust populates this from
    // `meditate_core::db::list_labels_from_db` and stamps the
    // `selected` flag on the row matching the active mode's
    // resolved label.
    in property <[LabelItem]> label-items: [];

    // Create-label dialog state. The synthetic "Create new
    // label…" row at the top of the chooser opens it; Rust
    // revalidates on every `create-label-changed` keystroke (via
    // `meditate_core::validate` against `is_label_name_taken_from_db`)
    // and writes the result back to `create-label-valid` so the
    // Create button's `enabled` reflects the live validity.
    in-out property <bool> create-label-dialog-open: false;
    in-out property <string> create-label-text: "";
    in property <bool> create-label-valid: false;

    // Rename-label dialog state. Same shape as the Create
    // dialog, but Rust passes the label's own id as `except_id`
    // when revalidating so a user retyping the existing name
    // (e.g., to fix capitalisation) doesn't trip the collision
    // check. Mirrors `present_rename_label_dialog` in
    // `meditate-gtk/src/labels.rs`.
    in-out property <bool> rename-label-dialog-open: false;
    in-out property <int> rename-label-id: 0;
    in-out property <string> rename-label-text: "";
    in property <bool> rename-label-valid: false;

    // Delete-label dialog state. Rust computes the impact body
    // ("This label is not used by any sessions." vs "N sessions
    // tagged with this label will be un-labelled: N") via
    // `meditate_core::labels::delete_impact_key`, pushes it into
    // `delete-label-body` before opening the dialog. Mirrors
    // `present_delete_label_dialog` in `labels.rs:361`.
    in-out property <bool> delete-label-dialog-open: false;
    in-out property <int> delete-label-id: 0;
    in property <string> delete-label-body: "";

    // Per-session label pick that rides with the Done screen —
    // mirrors GTK's `done_selected_label_id` Cell at
    // `timer/imp.rs:211`. Initialized from Setup's resolved
    // label when Done opens, mutable on the Done screen, and
    // what `Save` ultimately writes as the session row's
    // `label_id`. The Done choice also persists back to the
    // mode's default on Save via `resolve_persist_action`.
    in-out property <bool> done-label-active: false;
    in property <string> done-label-name: "";
    in-out property <int> done-label-id: 0;

    // Top-level navigation: 0 = Timer page (Setup + Running +
    // Done overlays; the existing single-screen experience),
    // 1 = Log page (session feed grouped by day). Mirrors GTK's
    // `AdwViewStack` with Timer / Log / Stats / Preferences
    // children; this slice ships only the first two destinations.
    in-out property <int> nav-page: 0;

    // Sessions rendered in the Log page. Rust pre-groups by date
    // and pushes a `[LogDaySection]`; Slint iterates sections +
    // their items. Empty array → Log empty state.
    in property <[LogDaySection]> log-sections: [];
    // True when the last page returned a full PAGE_SIZE rows
    // (more might still exist). Drives the "Load more" button's
    // visibility — mirrors GTK's
    // `load_more_btn.set_visible(n == PAGE_SIZE)` at
    // `meditate-gtk/src/log/imp.rs:195`.
    in property <bool> log-has-more: false;

    // Routing flag for the shared label chooser overlay:
    //   0 = opened from the Setup expander row (existing flow —
    //       picks write to the active mode's UUID setting).
    //   1 = opened from the Done expander row (new flow — picks
    //       update `done-label-id` / `done-label-name` only;
    //       persistence to the mode setting happens on Save via
    //       `resolve_persist_action`).
    in-out property <int> chooser-target: 0;

    // Box Breath phase pattern (in / hold-in / out / hold-out, in
    // seconds). Mirrors `meditate-gtk/src/timer/imp.rs::breathing_pattern`
    // (a `Cell<BreathPattern>` with the four fields). Rust seeds
    // these on launch from the DB settings (`breathing_in`,
    // `breathing_hold_in`, `breathing_out`, `breathing_hold_out`)
    // and writes back via `bb-adjust`. Defaults match
    // `BreathPattern::box_breath()` = 4-4-4-4.
    in property <int> bb-in: 4;
    in property <int> bb-hold-in: 4;
    in property <int> bb-out: 4;
    in property <int> bb-hold-out: 4;

    // Box Breath running-view properties. Rust updates them
    // every tick when the active session is a BoxBreathCountdown
    // or BoxBreathStopwatch shape (detected via
    // `Session::box_breath_phase_info`); `bb-running-active`
    // flips the Running overlay's layout from Timer hero to
    // the square + dot visualization.
    in property <bool> bb-running-active: false;
    // "Box Breathing" eyebrow counter — "M:SS / M:SS" for
    // countdown shapes, just "M:SS" for stopwatch (see
    // `meditate_core::format::box_breath_counter_label`).
    in property <string> bb-counter-text: "0:00";
    // Phase label ("Breathe in" / "Hold" / "Breathe out"),
    // Rust-formatted from `PhaseRunningLabelKey`.
    in property <string> bb-phase-label: "";
    // Per-phase remaining seconds — the big numeric overlay
    // centred inside the square.
    in property <int> bb-phase-seconds: 0;
    // Perimeter-point coordinates of the moving dot, computed
    // by Rust via `Phase::perimeter_point(t, pad=12, side=196)`.
    // The 220×220 SquareFrame below uses pad=12 / side=196 so
    // these coordinates land inside its drawing area.
    in property <length> bb-dot-x: 12px;
    in property <length> bb-dot-y: 208px;

    in-out property <bool> duration-dialog-open: false;
    in-out property <int> dialog-hours: 0;
    in-out property <int> dialog-minutes: 10;

    // Note field on the Done screen. Bound to Material's TextField
    // so the on-screen keyboard / IME show up on focus, and the
    // Rust side reads this value on Save.
    in-out property <string> note-text: "";

    callback action-tap();
    callback stop-tap();
    callback duration-tap();
    callback stopwatch-toggled(bool);
    // Fires after the Duration dialog's Set button commits new
    // setup-hours / setup-minutes — Rust then routes the new
    // total seconds to the active mode's storage (Timer keeps
    // its value in-memory; Box Breath persists to
    // `breathing_session_secs`). Mirrors GTK's separate
    // `countdown_target_secs` / `breathing_session_secs` cells
    // backing the otherwise-shared Adw.ActionRow.
    callback duration-committed();
    callback save-tap();
    callback discard-tap();
    callback mode-changed(int);
    callback keep-awake-toggled(bool);
    callback cues-changed(int);
    callback label-active-toggled(bool);
    callback label-tap();
    callback labels-back();
    callback label-picked(int);
    callback create-label-tap();
    callback create-label-changed(string);
    callback create-label-confirm();
    callback rename-label-tap(int);
    callback rename-label-changed(string);
    callback rename-label-confirm();
    callback delete-label-tap(int);
    callback delete-label-confirm();
    callback done-label-active-toggled(bool);
    callback done-label-tap();
    // Per-phase stepper. `index` is 0=In, 1=HoldIn, 2=Out, 3=HoldOut
    // (matches `BreathPattern::phase_min_secs(index)` + the GTK
    // shell's `adjust_phase(index, delta, min_val)` signature).
    // `delta` is -1 or +1.
    callback bb-adjust(int, int);
    // Hardware back button + Android predictive back gesture.
    // Wired through a root-level FocusScope so the key event
    // reaches us no matter which sub-element holds focus. Rust
    // decides whether to navigate up one level (close an overlay
    // / dismiss Done) or fall through to "close the app".
    callback back-pressed();
    // Bottom NavigationBar selection changed.
    callback nav-changed(int);
    // "Load more" button at the bottom of the Log feed taps —
    // fetches the next page from the DB and appends to the
    // existing sections. Mirrors GTK's `load_more_btn.connect_clicked`.
    callback load-more-tap();

    // Trash IconButton on each Log card was tapped — Rust hides
    // the row optimistically (shadow filter), pushes it into the
    // pending-deletes list, and shows / refreshes the undo
    // snackbar. Mirrors GTK's `delete_btn.connect_clicked` →
    // `on_delete_clicked` flow in `meditate-gtk/src/log/imp.rs`.
    callback delete-tap(int);

    // Undo snackbar — the Material 3 analogue of GTK's coalescing
    // `adw::Toast` ("N sessions deleted · Undo"). Rust drives both
    // properties: `snackbar-visible` toggles the overlay, and
    // `snackbar-text` is the localised "N sessions deleted" copy
    // (`meditate_core::announcement::Announcement::SessionDeleted`
    // rendered Rust-side). Tapping the Undo action raises the
    // callback; auto-dismiss is a 5 s `slint::Timer` armed in Rust
    // alongside the toggle.
    in property <string> snackbar-text: "";
    in property <bool> snackbar-visible: false;
    callback snackbar-undo-tap();

    // Edit-Session overlay (L-4). Tapping a Log card opens a full-
    // window slide-in mirroring GTK's `show_session_dialog` in
    // `meditate-gtk/src/log/imp.rs:762`. L-4a ships note-only —
    // duration, start time, and label come in L-4b / L-4c / L-4d.
    // Rust drives `edit-session-page` (visibility), pre-fills
    // `edit-note-text` from the tapped Session's notes column on
    // open, reads it back when `edit-save-tap` fires, builds a
    // `Session` struct preserving every other field, and writes
    // through `db.update_session(id, &session)`.
    in property <bool> edit-session-page: false;
    in-out property <string> edit-note-text: "";
    // Duration fields (L-4b) — Rust pre-fills both on card-tap
    // from the tapped session's `duration_secs`, reads them back
    // on edit-save-tap and recomposes `secs = h*3600 + m*60`.
    // Ranges mirror GTK's adjustments at `log/imp.rs:778 / :784`
    // (Hours 0-23, Minutes 0-59).
    in-out property <int> edit-duration-hours: 0;
    in-out property <int> edit-duration-minutes: 0;
    // Start-time fields (L-4c). Rust decomposes the tapped
    // session's `start_time` (unix seconds, local-tz interpreted)
    // into a `Date { year, month, day }` and a `Time { hour,
    // minute }` on card-tap; the Material DatePickerPopup +
    // TimePickerPopup write back to these on accept, and the
    // Save handler recomposes a unix timestamp via chrono's
    // `Local.with_ymd_and_hms`. Defaults are the chrono epoch /
    // midnight so the picker has *some* date when the overlay
    // opens before Rust populates them (defensive — card-tap
    // always overwrites before user-visible).
    in-out property <Date> edit-start-date: { year: 2026, month: 1, day: 1 };
    in-out property <Time> edit-start-time: { hour: 0, minute: 0 };
    // Label fields (L-4d). `edit-label-enabled` is the AdwExpander
    // master switch — when off, Save writes `label_id = None` and
    // the selected row is hidden. `edit-label-id` carries the rowid
    // of the currently picked label (0 = none yet). `edit-label-
    // name` is just the display string for the row, kept in sync
    // by Rust on every prefill / pick.
    in-out property <bool> edit-label-enabled: false;
    in-out property <int> edit-label-id: 0;
    in-out property <string> edit-label-name: "";
    callback card-tap(int);
    callback edit-cancel-tap();
    callback edit-save-tap();
    // Tap on the "Selected" row inside the Edit-Session Label
    // group → open the labels chooser (`labels-page`). Rust sets
    // `chooser-target = 2` before flipping `labels-page = true` so
    // the existing `on_label_picked` handler routes the pick back
    // to `edit-label-*` instead of Setup or Done.
    callback edit-label-row-tap();
    // Master-switch toggle on the Label expander. Rust adopts the
    // first available label on the off→on flip if no selection
    // exists yet (mirrors GTK's `connect_enable_expansion_notify`
    // at `meditate-gtk/src/log/imp.rs:890`).
    callback edit-label-toggled(bool);

    // Slide offset driving the Running screen's slide-over. 0 px
    // means Running is parked at x=width (off-screen right) and
    // Setup is fully visible underneath. Animating up to `root.width`
    // brings Running to x=0, covering Setup. Setup itself never
    // moves — matches Adw.NavigationView push semantics where only
    // the incoming page animates and the outgoing page sits in
    // place beneath. Easing matches GTK's push curve — quick first,
    // slow finish — so the two shells feel related, not just look it.
    property <length> screen-offset: root.running-page ? root.width : 0px;
    animate screen-offset { duration: 300ms; easing: ease-out; }

    // Bottom NavigationBar reserves a fixed slab at the bottom
    // of the window; every top-level page (Setup, Log) sizes its
    // height to `parent.height - nav-bar-height` so the content
    // never sits beneath the bar.
    property <length> nav-bar-height: 80px;

    // Top AppBar (title + Preferences button) on top of every
    // main page. 64 px matches Material's stock AppBar min
    // height. The base pages (Setup, Log) live below it; the
    // Running / Done / Labels overlays cover the header since
    // they're full-window destinations.
    property <length> header-bar-height: 64px;

    // System status-bar inset. Slint's android backend doesn't
    // currently surface `WindowInsets`, so this is a hard-coded
    // approximation tuned to Janek's Fairphone 5 (Android 15) —
    // the AppBar content + Preferences icon both need padding
    // out of the notch / status-symbol zone. Keep tweakable
    // until safe-area-inset wiring lands (phase 8 polish).
    property <length> status-bar-inset: 36px;

    // Mirror inset along the bottom edge — half the top inset is
    // enough to keep the NavigationBar + Pause/Stop / Save /
    // Discard rows clear of the system gesture hint and the
    // rounded screen-corner mask. Same hard-coded fallback
    // pattern as `status-bar-inset` until proper insets land.
    property <length> bottom-bar-inset: root.status-bar-inset / 2;

    // Trailing icon button on the top header — taps will open
    // a future Preferences sheet. No-op for now; placeholder
    // until phase 7 lands the preferences UI.
    callback preferences-tap();

    // Filter sheet (L-5). Tapping the funnel IconButton in the
    // Log AppBar flips `filter-sheet-open` true via the
    // `log-filter-tap` callback; Rust then refreshes any sheet-
    // populated state (label list for L-5c) before the sheet
    // animates in. L-5a only ships the surface — the inner
    // controls land in L-5b (Notes-only) and L-5c (Label).
    in-out property <bool> filter-sheet-open: false;
    callback log-filter-tap();

    // Sync-status indicator (Phase 3 close-out). Mirrors GTK's
    // `sync_status_btn` at `meditate-gtk/data/ui/window.blp:58`
    // + `refresh_sync_status` at
    // `meditate-gtk/src/window/imp.rs:630`. State is derived
    // Rust-side via `meditate_core::sync::indicator::
    // state_from_db`:
    //   0 = Hidden  → not rendered (no Nextcloud account)
    //   1 = Syncing → indeterminate CircularProgressIndicator
    //   2 = Error   → warning glyph, error tint
    //   3 = Ok      → check glyph, primary tint
    // On Android the sync loop itself lands in Phase 7, so the
    // realistic state today is Hidden — this wires the surface
    // so Phase 7 only has to make sync actually run. The tap is
    // a no-op placeholder until then (GTK's `action_for`
    // targets — recovery dialog / prefs / retry — don't exist
    // on Android yet).
    in property <int> sync-indicator-state: 0;
    in property <string> sync-indicator-tooltip: "";
    callback sync-indicator-tap();

    // Has-Notes filter (L-5b). `filter-notes-only` is the live
    // flag the Rust paginator reads via `get_filter_notes_only`
    // when building the `SessionFilter`. `filter-notes-toggled`
    // fires on every switch flip — Rust resets the feed to
    // page 0 with the new filter and closes the sheet, mirroring
    // GTK's instant-apply + popdown at
    // `meditate-gtk/src/window/imp.rs:792`.
    in-out property <bool> filter-notes-only: false;
    callback filter-notes-toggled(bool);

    // Label filter (L-5c). Mirrors GTK's `filter_label_row`
    // ComboRow at `meditate-gtk/data/ui/window.blp:106` +
    // `refresh_filter_labels` at
    // `meditate-gtk/src/log/imp.rs:305`. `filter-label-items`
    // is Rust-populated as ["All labels", <name>, …]; index 0
    // clears the filter. `filter-label-index` is the dropdown's
    // current selection (kept in sync both ways);
    // `filter-label-selected` fires on pick — Rust resolves
    // index→rowid, reloads page 0, and closes the sheet.
    in property <[MenuItem]> filter-label-items: [];
    // Defaults to -1 (not 0) so the first Rust-driven
    // `refresh_filter_label_items` — which sets the real active
    // index (0 = "All labels") — is always a genuine value
    // *change*. DropDownMenu only refreshes its displayed text
    // from inside `changed current_index`, so a -1 → 0 first
    // sync is what makes "All labels" actually render on the
    // very first open.
    in-out property <int> filter-label-index: -1;
    // Resolved label rowid the paginator filters on (0 = "All
    // labels" / no filter). Rust maps the picked dropdown index
    // to this via the loaded label list; kept separate from
    // `filter-label-index` because the dropdown row order is a
    // UI concern while the rowid is what `SessionFilter` needs.
    in-out property <int> filter-label-id: 0;
    callback filter-label-selected(int);

    // True when any of the Log-feed filters is engaged. L-5a
    // exposes this as the gate between the "No Sessions Yet"
    // and "No Matching Sessions" empty states; L-5b / L-5c set
    // it Rust-side as the Notes / Label filters activate. The
    // Log-feed render path uses `filter-has-active` regardless
    // of which specific filter is on — mirrors GTK's
    // `has_filter` at `meditate-gtk/src/log/imp.rs:144`.
    in property <bool> filter-has-active: false;

    // Slide offset for the Label chooser overlay. Symmetric
    // 300 ms in both directions — mirrors the GTK
    // `AdwNavigationView` push transition. No coordination with
    // Done/Running, so no asymmetric duration trick needed.
    property <length> labels-offset: root.labels-page ? root.width : 0px;
    animate labels-offset { duration: 300ms; easing: ease-out; }

    // Slide offset for the Edit-Session overlay. Symmetric 300 ms
    // mirroring `AdwNavigationView` push of `show_session_dialog`
    // — Adw.Dialog itself slides up on phone form-factors and the
    // edit dialog here is the same kind of full-window
    // destination, so push-from-the-right keeps animation
    // direction consistent with the other overlays.
    property <length> edit-session-offset: root.edit-session-page ? root.width : 0px;
    animate edit-session-offset { duration: 300ms; easing: ease-out; }

    // Slide offset for the Done overlay. Asymmetric duration:
    // appearing is INSTANT (0 ms) so Done is already at x=0 by the
    // time Running starts sliding off — the user experiences the
    // Running overlay sliding right to *reveal* a static Done
    // underneath, not two layers crisscrossing. Disappearing
    // animates 300 ms so Save / Discard slides Done off to the
    // right and reveals Setup. The conditional reads `done-page`
    // at the moment of the change; transitioning into done-page=true
    // picks 0 ms, transitioning out picks 300 ms.
    property <length> done-offset: root.done-page ? root.width : 0px;
    animate done-offset {
        duration: root.done-page ? 0ms : 300ms;
        easing: ease-out;
    }

    // Route initial focus into a FocusScope wrapping every page so
    // the Android back button / predictive-back gesture reaches
    // our key-pressed handler. Slint maps `Keycode::Back` to
    // `Key.Back` and bubbles it up through the focused element's
    // parent chain — wrapping everything keeps the key reachable
    // even after focus moves to a TextInput inside the Note field
    // on the Done screen.
    forward-focus: root-focus;

    root-focus := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Back {
                root.back-pressed();
                return accept;
            }
            reject
        }

    // ── Setup screen ─────────────────────────────────────────────
    // Permanent base layer at x=0. Running slides over the top on
    // Start and off on Stop; Done slides over the top from x=0 to
    // x=width on Save / Discard. Setup itself never moves and
    // never hides — it just gets covered.
    Rectangle {
        visible: root.nav-page == 0;
        x: 0;
        width: parent.width;
        height: parent.height;

        // Setup is wrapped in a Flickable so the content scrolls
        // past the bottom NavigationBar when it overflows —
        // mirrors GTK's `Gtk.ScrolledWindow { hscrollbar-policy:
        // never; vexpand: true }` wrapper on the setup StackPage.
        // Bottom padding equals `nav-bar-height` so the last row
        // is reachable above the bar after scrolling.
        Flickable {
            width: 100%;
            height: 100%;
            viewport-width: self.width;
            viewport-height: setup-stack.preferred-height;

            setup-stack := VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: root.status-bar-inset + root.header-bar-height + 16px;
            padding-bottom: root.nav-bar-height + root.bottom-bar-inset + 24px;
            spacing: 20px;
            alignment: start;

            // Hero area — mirrors the GTK shell's hero block at
            // `timer_view.blp` lines 26-51: streak chip on top,
            // big time readout in the middle, mode-aware caption
            // beneath. GTK puts this FIRST in the parent vbox;
            // the mode chip group lives below it (next child).
            VerticalLayout {
                spacing: 4px;

                // Streak chip slot. Empty until phase 3's DB
                // persistence lights it up; sized to leave the
                // visual gap GTK's `streak_label` reserves even
                // when its text is blank.
                Text {
                    text: root.streak-text;
                    font-size: 14px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface-variant;
                }
                Text {
                    text: root.remaining-text;
                    font-size: 80px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface;
                }
                Text {
                    text: "Hours · Minutes";
                    font-size: 12px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface-variant;
                }
            }

            // Mode chip group — mirrors GTK's
            // `Adw.ToggleGroup mode_toggle_group` (Timer / Guided
            // / Box Breath) just below the hero. Same toggle order
            // as the .blp so a persisted index works across both
            // shells. Guided + Box Breath are surface only in this
            // slice (no audio engine / no Box Breath running view
            // yet); Start stays disabled when either is selected.
            SegmentedButton {
                current-index <=> root.setup-mode;
                items: [
                    { text: "Timer" },
                    { text: "Guided" },
                    { text: "Box Breath" },
                ];
                index-changed(idx) => { root.mode-changed(idx); }
            }

            // Start Session button — above the settings, in thumb
            // reach. Taller than Material 3's 40 px default because
            // it's the single most-tapped surface on the app.
            // Guided stays disabled until the audio engine arrives
            // (phase 5). Stopwatch Mode bypasses the duration check —
            // an open-ended count-up needs no target, mirroring
            // GTK's `on_start` which only validates
            // `countdown_target_secs` when `!stopwatch_toggle_on.get()`.
            FilledButton {
                text: "Start Session";
                height: 56px;
                enabled: (root.setup-mode == 0 || root.setup-mode == 2)
                    && (root.stopwatch-on
                        || root.setup-hours > 0
                        || root.setup-minutes > 0);
                clicked => { root.action-tap(); }
            }

            // Timer body — Session group mirrors the GTK
            // `session_group` (Adw.PreferencesGroup titled "Session"
            // at `timer_view.blp` line 299). Phase-1 + this slice
            // ship the Stopwatch and Duration rows; Cues, Label,
            // and Keep-Screen-Awake land in their own slices.
            // Visible in Timer mode only (Stopwatch / Duration are
            // Timer-mode rows per the .blp visibility rules).
            if root.setup-mode == 0 : VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Session";
                    font-size: 14px;
                    font-weight: 700;
                    color: MaterialPalette.primary;
                    horizontal-alignment: left;
                }

                BoxedList {
                    // Cues row sits FIRST — mirrors the GTK .blp
                    // ordering (Cues → Stopwatch → Duration → Label →
                    // Keep Awake). Visible in every mode in GTK; the
                    // Session group is still Timer-gated here, so this
                    // slice keeps it inside that gate.
                    CuesRow {
                        title: "Cues";
                        current-index <=> root.cues-mode;
                        changed(idx) => { root.cues-changed(idx); }
                    }

                    // 1 px divider — mirrors GTK's `Adw.PreferencesGroup`
                    // row separator. on-surface-variant has the right
                    // mid-tone for a hairline that's visible without
                    // shouting.
                    Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline-variant;
                    }

                    SwitchRow {
                        title: "Stopwatch Mode";
                        subtitle: "Count up from zero";
                        checked <=> root.stopwatch-on;
                        toggled(value) => { root.stopwatch-toggled(value); }
                    }

                    Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline-variant;
                    }

                    DurationRow {
                        value-text: root.duration-text;
                        enabled: !root.stopwatch-on;
                        tapped => { root.duration-tap(); }
                    }

                    Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline-variant;
                    }

                    // Label expander — mirrors `setup_label_enabled_row`.
                    // Master switch toggles per-mode label tagging;
                    // when on, the inner Selected row shows the
                    // resolved label name. Tap on the inner row will
                    // push the label chooser screen in the next
                    // phase-2 slice; for now it's a no-op stub.
                    ExpanderRow {
                        title: "Label";
                        subtitle: "Tag this session";
                        body-title: "Selected";
                        body-subtitle: root.label-name;
                        active <=> root.label-active;
                        toggled(value) => { root.label-active-toggled(value); }
                        body-tapped => { root.label-tap(); }
                    }

                    Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline-variant;
                    }

                    // Keep Screen Awake — mirrors GTK's
                    // `keep_screen_awake_row`. GTK shows this row in
                    // every mode; this slice keeps it inside the
                    // Timer-only Session group along with Stopwatch
                    // and Duration. Restructuring lands when the
                    // Box Breath / Guided bodies do.
                    SwitchRow {
                        title: "Keep Screen Awake";
                        subtitle: "Prevent display sleep during a session";
                        checked <=> root.keep-awake-on;
                        toggled(value) => { root.keep-awake-toggled(value); }
                    }
                }
            }

            // Placeholder body for Guided / Box Breath — the GTK
            // shell builds full guided_section / boxbreath_inputs
            // panes here. The Android counterparts land in the
            // next phase-2 slices; for now a single-line note
            // keeps the gap visible without faking functionality.
            if root.setup-mode == 1 : Text {
                text: "Guided mode lands with the audio engine in phase 5.";
                font-size: 14px;
                color: MaterialPalette.on-surface-variant;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            // Box Breath body — Breath Phases heading + 2×2 phase
            // tile grid + the shared Session group (Stopwatch, the
            // shared Duration row drives both modes' session
            // length, Label, Keep Awake). Mirrors GTK's
            // `boxbreath_inputs` Box (`timer_view.blp:189-221`) +
            // the shared `session_group` rows.
            if root.setup-mode == 2 : VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Breath Phases";
                    font-size: 14px;
                    font-weight: 700;
                    color: MaterialPalette.primary;
                    horizontal-alignment: left;
                }

                GridLayout {
                    spacing: 8px;

                    // Per-phase icons mirror GTK's
                    // `build_phase_tiles` spec at `imp.rs:4059`:
                    //   Inhale       → go-up-symbolic
                    //   Hold (full)  → media-playback-pause
                    //   Exhale       → go-down-symbolic
                    //   Hold (empty) → media-playback-pause
                    // Material's bundled Icons set covers
                    // arrow_drop_up / arrow_drop_down (filled
                    // triangles, the closest analogue to GNOME's
                    // outline chevrons); pause has no Material
                    // equivalent so the shell ships its own SVG.
                    Row {
                        PhaseTile {
                            title: "Inhale";
                            icon: Icons.arrow-drop-up;
                            index: 0;
                            seconds: root.bb-in;
                            min-seconds: 1;
                            adjust(i, d) => { root.bb-adjust(i, d); }
                        }
                        PhaseTile {
                            title: "Hold (full)";
                            icon: @image-url("assets/pause.svg");
                            index: 1;
                            seconds: root.bb-hold-in;
                            min-seconds: 0;
                            adjust(i, d) => { root.bb-adjust(i, d); }
                        }
                    }
                    Row {
                        PhaseTile {
                            title: "Exhale";
                            icon: Icons.arrow-drop-down;
                            index: 2;
                            seconds: root.bb-out;
                            min-seconds: 1;
                            adjust(i, d) => { root.bb-adjust(i, d); }
                        }
                        PhaseTile {
                            title: "Hold (empty)";
                            icon: @image-url("assets/pause.svg");
                            index: 3;
                            seconds: root.bb-hold-out;
                            min-seconds: 0;
                            adjust(i, d) => { root.bb-adjust(i, d); }
                        }
                    }
                }

                Text {
                    text: "Session";
                    font-size: 14px;
                    font-weight: 700;
                    color: MaterialPalette.primary;
                    horizontal-alignment: left;
                }

                BoxedList {
                    // Stopwatch — mirrors GTK's
                    // `stopwatch_mode_row.set_visible(true)`
                    // unconditional call in `on_mode_switched`
                    // (the .blp comment claiming it's Timer-only
                    // is stale). Flips
                    // `BoxBreathCountdown` ↔ `BoxBreathStopwatch`
                    // at session start.
                    SwitchRow {
                        title: "Stopwatch Mode";
                        subtitle: "Count up from zero";
                        checked <=> root.stopwatch-on;
                        toggled(value) => { root.stopwatch-toggled(value); }
                    }

                    Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline-variant;
                    }

                    DurationRow {
                        value-text: root.duration-text;
                        enabled: !root.stopwatch-on;
                        tapped => { root.duration-tap(); }
                    }

                    Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline-variant;
                    }

                    // Label expander — same component as the
                    // Timer body's row, wired to the same
                    // `label-*` properties + `label-tap`
                    // callback. Per-mode persistence happens
                    // Rust-side via the active mode chip, so the
                    // master toggle on Box Breath writes
                    // `label_active_breathing` and selects
                    // through the seeded "Box-Breathing" default.
                    ExpanderRow {
                        title: "Label";
                        subtitle: "Tag this session";
                        body-title: "Selected";
                        body-subtitle: root.label-name;
                        active <=> root.label-active;
                        toggled(value) => { root.label-active-toggled(value); }
                        body-tapped => { root.label-tap(); }
                    }
                }
            }
            }   // close setup-stack VerticalLayout
        }       // close Flickable
    }           // close Setup Rectangle

    // ── Done screen (overlay) ───────────────────────────────────
    // Mirrors `meditate-gtk/data/ui/timer_view.blp`'s `done` stack
    // page (lines 747-833) — outer Box uses `valign: center` so the
    // whole stack centers vertically, with `spacing: 18` between
    // elements and a small horizontal margin.
    //
    // Driven by `done-offset`. Appears instantly at x=0 the moment
    // a session ends (Running overlay then slides off to the right,
    // revealing this), and slides off to the right itself on
    // Save / Discard, revealing Setup. (The GTK shell uses an
    // instant view-stack swap for both edges — we keep the slide
    // out per Janek's preference for the Android shell.)
    Rectangle {
        visible: root.nav-page == 0;
        x: parent.width - root.done-offset;
        width: parent.width;
        height: parent.height;
        background: MaterialPalette.surface;

        Flickable {
            width: 100%;
            height: 100%;
            viewport-width: self.width;
            // `max(self.height, content.preferred-height)` keeps
            // short Done screens vertically centred (content
            // shorter than viewport → viewport height takes over
            // and the inner VerticalLayout's `alignment: center`
            // has slack to centre with); a long note grows the
            // viewport past Flickable's height and scrolling
            // kicks in (no more centring then, which is desired).
            viewport-height: max(self.height, done-stack.preferred-height);

            done-stack := VerticalLayout {
            width: 100%;
            height: parent.viewport-height;
            alignment: center;
            spacing: 18px;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: root.status-bar-inset + 24px;
            padding-bottom: root.bottom-bar-inset + 24px;

            // Elapsed time — the user's "this is what you did"
            // readout. GTK uses `halign: center` on the label;
            // mirrored via horizontal-alignment.
            Text {
                text: root.elapsed-text;
                font-size: 80px;
                horizontal-alignment: center;
                color: MaterialPalette.on-surface;
            }

            // Note label + multi-line input. GTK uses a Gtk.TextView
            // inside a 180px ScrolledWindow with word-wrap; `NoteField`
            // above is the Slint equivalent. Caption is start-aligned
            // with a 12px indent in GTK (`note_caption.margin-start: 12`).
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Note (optional)";
                    font-size: 12px;
                    color: MaterialPalette.on-surface-variant;
                    horizontal-alignment: left;
                }
                NoteField {
                    label: "Note";
                    text <=> root.note-text;
                }
            }

            // Done-screen Label expander — mirrors the .blp
            // `done_label_enabled_row` (a sibling of the note +
            // button rows under the Done stack page). Master
            // toggle + inner Selected row are wired to the
            // `done-label-*` properties; `chooser-target = 1`
            // when this row's inner-row tap opens the chooser
            // so picks route back to the Done state rather than
            // the active mode's UUID setting.
            BoxedList {
                ExpanderRow {
                    title: "Label";
                    subtitle: "Tag this session";
                    body-title: "Selected";
                    body-subtitle: root.done-label-name;
                    active <=> root.done-label-active;
                    toggled(value) => { root.done-label-active-toggled(value); }
                    body-tapped => { root.done-label-tap(); }
                }
            }

            // Centered Discard / Save pill row — mirrors GTK's
            // `halign: center, homogeneous: true` button row.
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                // Discard: outline button, the closest Material 3
                // ships to GTK's `destructive-action` pill.
                OutlineButton {
                    text: "Discard";
                    height: 56px;
                    clicked => { root.discard-tap(); }
                }

                // Save: filled / suggested action.
                FilledButton {
                    text: "Save";
                    height: 56px;
                    clicked => { root.save-tap(); }
                }
            }
            }   // close done-stack VerticalLayout
        }       // close Flickable
    }           // close Done Rectangle

    // ── Running screen ──────────────────────────────────────────
    // Hero + controls vertically centered on a pure-black canvas.
    // GTK shell uses libadwaita's background-fade-to-black on the
    // running page; Material 3 has no canonical equivalent, so we
    // go straight to #000. Two layouts share this overlay: Timer
    // hero (digit countdown) and Box Breath visualisation (square
    // + perimeter dot). `bb-running-active` switches between them.
    Rectangle {
        visible: root.nav-page == 0;
        x: parent.width - root.screen-offset;
        width: parent.width;
        height: parent.height;
        background: #000000;

        VerticalLayout {
            alignment: center;
            spacing: 24px;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: root.status-bar-inset + 24px;
            padding-bottom: root.bottom-bar-inset + 24px;

            // Timer mode hero — digit countdown.
            if !root.bb-running-active : Text {
                text: root.remaining-text;
                font-size: 80px;
                horizontal-alignment: center;
                color: #ffffff;
            }

            // Box Breath visualisation — mirrors GTK's
            // `push_breathing_running_page` content vbox at
            // `meditate-gtk/src/window/imp.rs:254-498`. Top strip
            // (eyebrow + counter) → 220×220 overlay (frame + dot
            // + phase label + phase seconds) → buttons (the
            // buttons live in the parent VerticalLayout, shared
            // with Timer mode).
            if root.bb-running-active : VerticalLayout {
                spacing: 24px;
                alignment: center;

                // Top strip: "Box Breathing" eyebrow + counter.
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Box Breathing";
                        font-size: 12px;
                        horizontal-alignment: center;
                        color: #ffffffaa;
                    }
                    Text {
                        text: root.bb-counter-text;
                        font-size: 28px;
                        horizontal-alignment: center;
                        color: #ffffff;
                    }
                }

                // Square + dot overlay. The frame is a 196×196
                // rounded rectangle at (12, 12) inside a 220×220
                // container — matches GTK's pad=12, side=196
                // (cairo drawing area is 220px). Halo + dot are
                // positioned at the perimeter point Rust computes
                // via `Phase::perimeter_point(t, 12, 196)`; the
                // -7 / -11 offsets centre them on that coordinate.
                //
                // HorizontalLayout { alignment: center } keeps the
                // 220 px container horizontally centred in the
                // parent column (default VerticalLayout
                // packing left-aligns sub-parent-width children).
                HorizontalLayout {
                    alignment: center;
                Rectangle {
                    width: 220px;
                    height: 220px;

                    // Square frame — tinted fill + accent stroke.
                    Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 196px;
                        height: 196px;
                        border-radius: 20px;
                        background: MaterialPalette.primary.with-alpha(0.08);
                        border-width: 1.5px;
                        border-color: MaterialPalette.primary.with-alpha(0.45);
                    }

                    // Phase label + remaining-seconds overlay,
                    // centred inside the square — mirrors GTK's
                    // inner_stack at `imp.rs:305-312`.
                    VerticalLayout {
                        x: 12px;
                        y: 12px;
                        width: 196px;
                        height: 196px;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.bb-phase-label;
                            font-size: 14px;
                            horizontal-alignment: center;
                            color: MaterialPalette.primary;
                        }
                        Text {
                            text: root.bb-phase-seconds;
                            font-size: 56px;
                            horizontal-alignment: center;
                            color: #ffffff;
                        }
                    }

                    // Halo — semi-transparent accent disc behind
                    // the dot. Drawn before the dot so the dot
                    // body sits on top. `animate x, y` smooths the
                    // 200 ms tick-driven steps into glide-y motion;
                    // linear easing because the perimeter is
                    // axis-aligned (only one of x / y changes per
                    // phase) and corner crossings always land on
                    // the same coordinate before / after, so
                    // linear interpolation never cuts inside.
                    Rectangle {
                        x: root.bb-dot-x - 11px;
                        y: root.bb-dot-y - 11px;
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: MaterialPalette.primary.with-alpha(0.30);
                        animate x { duration: 200ms; easing: linear; }
                        animate y { duration: 200ms; easing: linear; }
                    }

                    // Dot — white fill with accent ring. Matches
                    // GTK's "white-filled, accent-bordered" dot
                    // at `imp.rs:374-380`.
                    Rectangle {
                        x: root.bb-dot-x - 7px;
                        y: root.bb-dot-y - 7px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: #ffffff;
                        border-width: 2.5px;
                        border-color: MaterialPalette.primary;
                        animate x { duration: 200ms; easing: linear; }
                        animate y { duration: 200ms; easing: linear; }
                    }
                }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                FilledButton {
                    text: root.action-label;
                    height: 56px;
                    clicked => { root.action-tap(); }
                }

                if root.stop-visible : OutlineButton {
                    text: "Stop";
                    height: 56px;
                    clicked => { root.stop-tap(); }
                }
            }
        }
    }

    // ── Create-label dialog (modal overlay) ─────────────────────
    // Mirrors `meditate-gtk/src/labels.rs::present_create_label_dialog`:
    // heading + single-line text entry + Cancel/Create buttons,
    // with Create disabled until the live-validated name is
    // non-empty AND not a case-insensitive collision against
    // existing labels. The validation closure lives Rust-side and
    // writes back to `create-label-valid` on every keystroke via
    // the `create-label-changed` callback.
    if root.create-label-dialog-open : Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { root.create-label-dialog-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: create-card-content.preferred-height;
            background: MaterialPalette.surface-container-high;
            border-radius: 28px;

            TouchArea {}

            create-card-content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Create Label";
                    font-size: 22px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface;
                }

                TextField {
                    label: "Label name";
                    text <=> root.create-label-text;
                    edited(text) => { root.create-label-changed(text); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    TextButton {
                        text: "Cancel";
                        clicked => { root.create-label-dialog-open = false; }
                    }
                    TextButton {
                        text: "Create";
                        enabled: root.create-label-valid;
                        clicked => { root.create-label-confirm(); }
                    }
                }
            }
        }
    }

    // ── Rename-label dialog (modal overlay) ─────────────────────
    // Mirrors `meditate-gtk/src/labels.rs::present_rename_label_dialog`:
    // single-line text entry pre-filled by Rust with the
    // current name, Cancel + Rename buttons (Rename initially
    // enabled since the unchanged name is a valid Ok). Rust
    // tracks the row's id via `rename-label-id` so the live
    // validator can pass it as `except_id`.
    if root.rename-label-dialog-open : Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { root.rename-label-dialog-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: rename-card-content.preferred-height;
            background: MaterialPalette.surface-container-high;
            border-radius: 28px;

            TouchArea {}

            rename-card-content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Rename Label";
                    font-size: 22px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface;
                }

                TextField {
                    label: "Label name";
                    text <=> root.rename-label-text;
                    edited(text) => { root.rename-label-changed(text); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    TextButton {
                        text: "Cancel";
                        clicked => { root.rename-label-dialog-open = false; }
                    }
                    TextButton {
                        text: "Rename";
                        enabled: root.rename-label-valid;
                        clicked => { root.rename-label-confirm(); }
                    }
                }
            }
        }
    }

    // ── Delete-label confirmation dialog (modal overlay) ────────
    // Mirrors `present_delete_label_dialog` in
    // `meditate-gtk/src/labels.rs:361`: heading + impact body +
    // Cancel/Delete buttons (Delete styled destructive). Rust
    // composes the body string from
    // `meditate_core::labels::delete_impact_key` before opening,
    // so the text correctly shows N/0 affected sessions.
    if root.delete-label-dialog-open : Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { root.delete-label-dialog-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: delete-card-content.preferred-height;
            background: MaterialPalette.surface-container-high;
            border-radius: 28px;

            TouchArea {}

            delete-card-content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Delete Label?";
                    font-size: 22px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface;
                }

                Text {
                    text: root.delete-label-body;
                    font-size: 14px;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    TextButton {
                        text: "Cancel";
                        clicked => { root.delete-label-dialog-open = false; }
                    }
                    // No native "destructive" style on TextButton —
                    // Material 3 has a `dangerButton` filled style
                    // but it's not in our component set. Plain
                    // TextButton keeps consistent with Cancel; the
                    // dialog title + the X-icon trigger already
                    // signal the destructive intent.
                    TextButton {
                        text: "Delete";
                        clicked => { root.delete-label-confirm(); }
                    }
                }
            }
        }
    }

    // ── Log page (base layer, nav-page == 1) ────────────────────
    // Mirrors GTK's `log_view.blp` Stack: empty state vs. list.
    // Scrollable via Flickable to match GTK's outer
    // `Gtk.ScrolledWindow`. Date sections + cards are rendered
    // from `log-sections` which Rust populates after every Save
    // and on every navigation into the Log page.
    Rectangle {
        visible: root.nav-page == 1;
        x: 0;
        width: parent.width;
        height: parent.height;
        background: MaterialPalette.surface;

        // Empty state — mirrors GTK's `Adw.StatusPage` with
        // icon + title + description. Two variants in GTK's
        // `view_stack` at `data/ui/log_view.blp:10-33`:
        //
        //   * "empty"          → no rows in the DB at all
        //   * "filtered-empty" → rows exist but the current filter
        //                        masks all of them
        //
        // Same gating here via `filter-has-active`: Rust flips it
        // true whenever any of the L-5b/c filters engage, and the
        // empty state swaps copy + caption accordingly.
        if root.log-sections.length == 0 && !root.filter-has-active : VerticalLayout {
            alignment: center;
            spacing: 12px;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: root.status-bar-inset + root.header-bar-height;
            padding-bottom: root.nav-bar-height + root.bottom-bar-inset;

            Text {
                text: "No Sessions Yet";
                font-size: 22px;
                horizontal-alignment: center;
                color: MaterialPalette.on-surface;
            }
            Text {
                text: "Start meditating to see your sessions here.";
                font-size: 14px;
                horizontal-alignment: center;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
            }
        }

        if root.log-sections.length == 0 && root.filter-has-active : VerticalLayout {
            alignment: center;
            spacing: 12px;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: root.status-bar-inset + root.header-bar-height;
            padding-bottom: root.nav-bar-height + root.bottom-bar-inset;

            Text {
                text: "No Matching Sessions";
                font-size: 22px;
                horizontal-alignment: center;
                color: MaterialPalette.on-surface;
            }
            Text {
                text: "Try changing your filters.";
                font-size: 14px;
                horizontal-alignment: center;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
            }
        }

        if root.log-sections.length > 0 : Flickable {
            width: 100%;
            height: 100%;
            viewport-width: self.width;
            viewport-height: log-stack.preferred-height;

            log-stack := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: root.status-bar-inset + root.header-bar-height + 12px;
                padding-bottom: root.nav-bar-height + root.bottom-bar-inset + 12px;
                spacing: 14px;

                for section in root.log-sections : VerticalLayout {
                    spacing: 8px;

                    // Date header — date label + dimmed
                    // count/total caption. Mirrors GTK's
                    // `build_section_frame` header at
                    // `log/imp.rs:331-347`.
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: section.date-display;
                            font-size: 16px;
                            font-weight: 700;
                            color: MaterialPalette.on-surface;
                            horizontal-alignment: left;
                        }
                        Text {
                            text: section.caption;
                            font-size: 12px;
                            color: MaterialPalette.on-surface-variant;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            horizontal-alignment: left;
                        }
                    }

                    // Cards in this section. Height grows with
                    // content (`min-height: 84px` keeps a sane
                    // floor); the note text wraps + clips at
                    // 2 lines via a fixed-height + clip wrapper
                    // (Slint's `overflow: elide` doesn't clip
                    // multi-line wrapped Text against `max-height`,
                    // so the wrapper is the reliable cap —
                    // mirrors GTK's `lines: 2; ellipsize: end` on
                    // the note Label, minus the literal ellipsis
                    // dots).
                    for item in section.items : card := Rectangle {
                        property <color> label-color:
                            item.color-index == 0 ? #3584e4 :
                            item.color-index == 1 ? #9141ac :
                            item.color-index == 2 ? #2ec27e :
                            item.color-index == 3 ? #e66100 :
                            item.color-index == 4 ? #e5a50a :
                            item.color-index == 5 ? #e01b24 :
                            item.color-index == 6 ? #986a44 :
                            item.color-index == 7 ? #1c71d8 :
                            MaterialPalette.on-surface.with-alpha(0.15);

                        min-height: 84px;
                        border-radius: 12px;
                        background: MaterialPalette.surface-container;

                        // Card-tap → edit-session dialog. Declared
                        // BEFORE the HorizontalLayout (and therefore
                        // its child IconButton) so the trash button's
                        // own click handler claims the trash hit-area
                        // and the surrounding card area falls through
                        // to this TouchArea — mirrors GTK's separate
                        // `card.add_controller(click)` +
                        // `delete_btn.connect_clicked` wiring at
                        // `meditate-gtk/src/log/imp.rs:492 / :472`.
                        TouchArea {
                            clicked => { root.card-tap(item.id); }
                        }

                        HorizontalLayout {
                            padding-left: 0px;
                            padding-right: 16px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 12px;
                            alignment: stretch;

                            // Colored label stripe — 3 px wide,
                            // colour-matched to the label name
                            // via `label_color_class_index`
                            // (palette mirrors GTK's
                            // `log_c0`..`log_c7`). The dim grey
                            // fallback (in `label-color` above)
                            // matches GTK's `log-c-none` style
                            // for unlabelled sessions.
                            Rectangle {
                                width: 3px;
                                border-radius: 1.5px;
                                background: card.label-color;
                            }

                            // Left column: minutes + "min" +
                            // time of day. Mirrors GTK's
                            // `left_col` at `log/imp.rs:401-407`.
                            VerticalLayout {
                                width: 64px;
                                alignment: center;
                                spacing: 0;
                                Text {
                                    text: item.minutes;
                                    font-size: 22px;
                                    font-weight: 700;
                                    color: MaterialPalette.on-surface;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: "min";
                                    font-size: 10px;
                                    color: MaterialPalette.on-surface-variant;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: item.time-of-day;
                                    font-size: 12px;
                                    color: MaterialPalette.on-surface-variant;
                                    horizontal-alignment: left;
                                }
                            }

                            // Right column: label chip + note.
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 4px;
                                if item.label-name != "" : Text {
                                    text: item.label-name;
                                    font-size: 12px;
                                    // Label name colour matches
                                    // the stripe — mirrors GTK's
                                    // `.log-label-chip.log-cN
                                    // { color: @log_cN }` rule.
                                    color: card.label-color;
                                    horizontal-alignment: left;
                                }
                                // Note text. Truncation to ~120
                                // chars + "…" happens Rust-side
                                // (`truncate_note_for_card`) so
                                // we don't have to coax Slint's
                                // multi-line elide. The Text
                                // grows naturally with `wrap:
                                // word-wrap`; the card's
                                // min-height keeps short notes
                                // visually balanced.
                                Text {
                                    text: item.note != ""
                                        ? item.note
                                        : "No note added";
                                    font-size: 14px;
                                    color: item.note != ""
                                        ? MaterialPalette.on-surface
                                        : MaterialPalette.on-surface-variant;
                                    horizontal-alignment: left;
                                    wrap: word-wrap;
                                }
                            }

                            // Trash IconButton — destructive tint
                            // via `has_error`, vertically centred
                            // against the full card height (the
                            // surrounding HorizontalLayout already
                            // stretches each child, so the button's
                            // base will park itself at the row's
                            // middle without extra alignment glue).
                            // Mirrors GTK's flat / circular /
                            // destructive `delete_btn` at
                            // `log/imp.rs:460`.
                            IconButton {
                                icon: @image-url("assets/delete.svg");
                                has_error: true;
                                clicked => { root.delete-tap(item.id); }
                            }
                        }
                    }
                }

                // Pagination button — visible only when the most
                // recent page came back full (more rows might
                // exist). Mirrors GTK's `load_more_btn` at
                // `meditate-gtk/src/log/imp.rs:62`. TonalButton is
                // the closest Material analogue to GTK's
                // `pill` style.
                if root.log-has-more : HorizontalLayout {
                    alignment: center;
                    TonalButton {
                        text: "Load more";
                        clicked => { root.load-more-tap(); }
                    }
                }
            }
        }
    }

    // ── Edit-Session overlay (slides over the Log page) ─────────
    // Mirrors GTK's `show_session_dialog` at
    // `meditate-gtk/src/log/imp.rs:762`. L-4a ships note-only —
    // the Duration / Start time / Label sections come in L-4b /
    // L-4c / L-4d. Declared AFTER the Log page Rectangle so the
    // sliding overlay draws on TOP of the feed (Slint's later
    // children render above earlier ones), not behind it. Header
    // layout matches the dialog's `adw::HeaderBar` (Cancel left,
    // title centre, Save right); background mirrors the Setup /
    // Log surface so a partial slide doesn't show through.
    Rectangle {
        visible: root.nav-page == 1;
        x: parent.width - root.edit-session-offset;
        width: parent.width;
        height: parent.height;
        background: MaterialPalette.surface;

        VerticalLayout {
            padding-top: root.status-bar-inset + 16px;
            padding-bottom: root.bottom-bar-inset + 16px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;
            alignment: start;

            // Header — Cancel (left) + title (centre) + Save
            // (right). Mirrors GTK's `header.pack_start(&cancel_btn)
            // / header.pack_end(&save_btn)` at
            // `log/imp.rs:998-1000`. Save uses FilledButton to
            // match the `suggested-action` CSS class on the GTK
            // Save button.
            HorizontalLayout {
                spacing: 12px;
                alignment: stretch;

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "Cancel";
                        clicked => { root.edit-cancel-tap(); }
                    }
                }
                Text {
                    text: "Edit Session";
                    font-size: 18px;
                    color: MaterialPalette.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    FilledButton {
                        text: "Save";
                        clicked => { root.edit-save-tap(); }
                    }
                }
            }

            // Duration row (L-4b). Deviation from GTK's inline
            // AdwSpinRows: Android mirrors the Setup-screen
            // pattern — a single tap-to-open `DurationRow` that
            // reuses the existing `duration-dialog` (two
            // VerticalSpinBoxes + Cancel/Set). On tap, Rust
            // seeds dialog-hours / dialog-minutes from the
            // current edit-duration-* and flips
            // `duration-dialog-open`; the dialog's Set handler
            // branches on `edit-session-page` to write back to
            // edit-duration-* instead of setup-*.
            BoxedList {
                DurationRow {
                    label: "Duration";
                    value-text: root.edit-duration-hours + "h "
                        + root.edit-duration-minutes + "m";
                    tapped => {
                        root.dialog-hours = root.edit-duration-hours;
                        root.dialog-minutes = root.edit-duration-minutes;
                        root.duration-dialog-open = true;
                    }
                }
            }

            // Start time group (L-4c). Two rows reusing
            // `DurationRow`'s shape (label + value + chevron):
            // Date opens Material's `DatePickerPopup`, Time opens
            // `TimePickerPopup`. Mirrors GTK's "Start time"
            // PreferencesGroup at `log/imp.rs:959` (Date row +
            // Hour SpinRow + Minute SpinRow); the Material popups
            // collapse Hour/Minute into a single picker.
            BoxedList {
                DurationRow {
                    label: "Date";
                    value-text: root.edit-start-date.year + "-"
                        + (root.edit-start-date.month < 10 ? "0" : "") + root.edit-start-date.month + "-"
                        + (root.edit-start-date.day < 10 ? "0" : "") + root.edit-start-date.day;
                    tapped => { date-popup.show(); }
                }
                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline-variant;
                }
                DurationRow {
                    label: "Time";
                    value-text:
                        (root.edit-start-time.hour < 10 ? "0" : "") + root.edit-start-time.hour + ":"
                        + (root.edit-start-time.minute < 10 ? "0" : "") + root.edit-start-time.minute;
                    tapped => { time-popup.show(); }
                }
            }

            // Label group (L-4d). Master SwitchRow + (when on) a
            // chooser row showing the current selection. Mirrors
            // GTK's `adw::ExpanderRow` with show_enable_switch +
            // inner "Selected" sub-row at `log/imp.rs:874`. Tap on
            // the chooser row pushes the existing labels-page
            // overlay; Rust uses `chooser-target = 2` to route the
            // pick back to `edit-label-*`.
            BoxedList {
                SwitchRow {
                    title: "Label";
                    subtitle: "Tag this session";
                    checked <=> root.edit-label-enabled;
                    toggled(on) => { root.edit-label-toggled(on); }
                }
                if root.edit-label-enabled : Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline-variant;
                }
                if root.edit-label-enabled : DurationRow {
                    label: "Selected";
                    value-text: root.edit-label-name;
                    tapped => { root.edit-label-row-tap(); }
                }
            }

            // Note field — caption + multi-line input. Mirrors
            // GTK's `note_caption` + `note_view` at
            // `log/imp.rs:933 / :915`. The existing NoteField
            // component already styles a filled-surface multiline
            // TextInput; binding `text` directly to
            // `root.edit-note-text` keeps the editor's content in
            // sync with the Rust-side property both ways.
            NoteField {
                label: "Note (optional)";
                text <=> root.edit-note-text;
            }
        }
    }

    // ── Label chooser (overlay, slides over everything) ─────────
    // Mirrors GTK's `push_labels_chooser`: a navigation push with
    // a back-button header bar + a list of label rows. Slides in
    // from the right via `labels-offset`; Setup, Running, Done,
    // Log, and Edit-Session all stay put underneath. Declared
    // AFTER the Edit-Session overlay so Slint's later-children-
    // on-top rule places this chooser z-above it — the chooser
    // surface can be opened from either the Setup screen (mode
    // label) or the Edit-Session overlay (per-session label),
    // and either underlying surface stays visible behind the
    // slide-in.
    Rectangle {
        x: parent.width - root.labels-offset;
        width: parent.width;
        height: parent.height;
        background: MaterialPalette.surface;

        VerticalLayout {
            padding-top: root.status-bar-inset + 24px;
            padding-bottom: root.bottom-bar-inset + 24px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;
            alignment: start;

            // Header — back arrow + title. Mirrors the
            // `Adw.HeaderBar { show-back-button: true }` +
            // `NavigationPage.title` GTK uses. The back button is
            // an IconButton (40 px touch target) on the left; an
            // equal-width spacer on the right balances the row
            // so the title actually centers in the page (rather
            // than sitting to the right of the back button).
            HorizontalLayout {
                spacing: 12px;
                alignment: stretch;

                IconButton {
                    icon: Icons.arrow-back;
                    clicked => { root.labels-back(); }
                }
                Text {
                    text: "Choose Label";
                    font-size: 18px;
                    color: MaterialPalette.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 40px;
                }
            }

            // Label list inside a BoxedList — same boxed look as
            // the Session group, so the chooser feels consistent.
            // Each iteration emits an optional 1 px hair-line
            // divider above the row (skipped for the first row),
            // mirroring the divider pattern between Cues /
            // Stopwatch / Duration / Label / Keep Awake in the
            // Session group.
            BoxedList {
                // Synthetic "Create new label…" row — mirrors the
                // top row that `rebuild_chooser_rows` adds in the
                // GTK shell (`labels.rs:107-139`). Always present
                // (no DB query needed) so the create-flow is one
                // tap away on first launch when no user labels
                // exist yet.
                Rectangle {
                    height: 56px;
                    background: create-touch.has-hover
                        ? MaterialPalette.surface-container-high
                        : transparent;

                    create-touch := TouchArea {
                        clicked => { root.create-label-tap(); }
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        alignment: stretch;

                        Text {
                            text: "Create new label…";
                            font-size: 16px;
                            color: MaterialPalette.on-surface;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // Plus glyph — GTK uses `list-add-symbolic`;
                        // Material's bundled Icons set has no add
                        // SVG, so we render the ASCII "+" (always
                        // rasterises, no font-coverage risk).
                        Text {
                            text: "+";
                            font-size: 22px;
                            color: MaterialPalette.on-surface-variant;
                            vertical-alignment: center;
                        }
                    }
                }

                // Divider separating the Create row from the
                // first label row.
                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline-variant;
                }

                for item[idx] in root.label-items : VerticalLayout {
                    spacing: 0;

                    if idx > 0 : Rectangle {
                        height: 1px;
                        background: MaterialPalette.outline-variant;
                    }

                    Rectangle {
                        height: 56px;
                        background: row-touch.has-hover
                            ? MaterialPalette.surface-container-high
                            : transparent;

                        row-touch := TouchArea {
                            clicked => { root.label-picked(item.id); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            alignment: stretch;

                            Text {
                                text: item.name;
                                font-size: 16px;
                                color: MaterialPalette.on-surface;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // Check-mark suffix on the currently-
                            // selected row — mirrors GTK's
                            // `object-select-symbolic` indicator.
                            // GTK adds this suffix BEFORE the rename
                            // + delete buttons (labels.rs:171 vs
                            // 174-175), so visually it lands to
                            // their left. VerticalLayout centers
                            // the image inside the 56-px row.
                            if item.selected : VerticalLayout {
                                alignment: center;
                                Image {
                                    source: Icons.check;
                                    colorize: MaterialPalette.primary;
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                            // Rename pencil button — mirrors GTK's
                            // `add_rename_button` (labels.rs:187).
                            // VerticalLayout centers the 40 px
                            // IconButton in the 56 px row.
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.edit;
                                    clicked => { root.rename-label-tap(item.id); }
                                }
                            }
                            // Delete X button — mirrors GTK's
                            // `add_delete_button` (labels.rs:209)
                            // which uses a `user-trash-symbolic`
                            // tinted with `.destructive-action`.
                            // Janek picked the X glyph for Android;
                            // Icons.close gives us the SVG and
                            // `has-error: true` colorises it with
                            // the Material error palette so the
                            // destructive intent reads at a glance.
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.close;
                                    has-error: true;
                                    clicked => { root.delete-label-tap(item.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Duration dialog (modal overlay, on top of both screens) ─
    // Declared AFTER the Edit-Session overlay so it draws on top
    // of it (Slint renders later children above earlier ones).
    // Without this z-order the popup opens but is occluded by
    // the Edit-Session slide-over surface and the user just sees
    // nothing happen on tap.
    if root.duration-dialog-open : Rectangle {
        // Scrim — taps outside the card cancel.
        background: #00000080;
        TouchArea {
            clicked => { root.duration-dialog-open = false; }
        }

        // Card. Height tracks the inner layout's preferred-height
        // so the card sizes to its content rather than stretching
        // to the scrim's full height.
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: card-content.preferred-height;
            background: MaterialPalette.surface-container-high;
            border-radius: 28px;

            // Catch clicks on the card itself so they don't reach
            // the scrim's TouchArea and dismiss the dialog.
            TouchArea {}

            card-content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Custom Time";
                    font-size: 22px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface;
                }
                Text {
                    text: "Hours : Minutes";
                    font-size: 14px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface-variant;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    VerticalSpinBox {
                        value <=> root.dialog-hours;
                        min-value: 0;
                        max-value: 23;
                    }
                    Text {
                        text: ":";
                        font-size: 40px;
                        vertical-alignment: center;
                        color: MaterialPalette.on-surface;
                    }
                    VerticalSpinBox {
                        value <=> root.dialog-minutes;
                        min-value: 0;
                        max-value: 59;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    TextButton {
                        text: "Cancel";
                        clicked => { root.duration-dialog-open = false; }
                    }
                    TextButton {
                        text: "Set";
                        clicked => {
                            // Refuse to commit a zero-duration set,
                            // mirroring the GTK shell's guard.
                            if (root.dialog-hours > 0 || root.dialog-minutes > 0) {
                                if (root.edit-session-page) {
                                    // Edit-Session overlay owns this
                                    // open — write the new value to
                                    // the edit-duration-* pair so the
                                    // Save handler picks it up.
                                    root.edit-duration-hours = root.dialog-hours;
                                    root.edit-duration-minutes = root.dialog-minutes;
                                } else {
                                    root.setup-hours = root.dialog-hours;
                                    root.setup-minutes = root.dialog-minutes;
                                    root.duration-committed();
                                }
                            }
                            root.duration-dialog-open = false;
                        }
                    }
                }
            }
        }
    }

    // ── Date + Time pickers (Material PopupWindows) ─────────────
    // Imperative show / close, driven from the Edit-Session
    // overlay's Date / Time row tap handlers. PopupWindows live
    // at the root so they pop above everything (Slint's
    // PopupWindow handles its own z-order separately from the
    // child-order rule that other overlays follow).
    // Explicit width/height: Material's PopupWindow components
    // rely on their inner `BaseDialog`/`Modal` layout to size them
    // via `layout_info.preferred`. On the Slint Android backend
    // (no native top-level popups, ChildWindow fallback) the
    // chain collapses to a 0x0 popup, which renders nothing but
    // still consumes focus — match the popup to the full window
    // so the inner centred Modal renders correctly.
    date-popup := DatePickerPopup {
        width: root.width;
        height: root.height;
        title: "Select session date";
        date: root.edit-start-date;
        accepted(date) => {
            root.edit-start-date = date;
            date-popup.close();
        }
        canceled => { date-popup.close(); }
    }

    time-popup := TimePickerPopup {
        width: root.width;
        height: root.height;
        title: "Select session time";
        use_24_hour_format: true;
        time: root.edit-start-time;
        ok => {
            root.edit-start-time = time-popup.get_current_time();
            time-popup.close();
        }
    }

    // ── Filter sheet (L-5) ──────────────────────────────────────
    // Modal overlay over the Log feed. Has Notes SwitchRow +
    // Label DropDownMenu; same scrim-tap-dismiss + card-tap-stop
    // pattern as the other modal dialogs.
    //
    // NB: gated by `visible:` rather than `if:` (unlike the
    // sibling dialogs). Material's `DropDownMenu` keeps its
    // displayed text in a private `text_field.text` that's only
    // refreshed from inside its own `changed current_index`
    // handler — there's no `in` text/selection setter. An
    // `if`-gated sheet rebuilds the DropDownMenu on every open,
    // and a freshly-constructed instance whose bound
    // `current-index` already equals the active value never
    // fires `changed`, so it renders blank. Keeping the subtree
    // alive (just hidden) preserves the dropdown's display
    // state across opens. `visible: false` elements don't render
    // or receive input, so the scrim still behaves modally.
    Rectangle {
        visible: root.filter-sheet-open;
        background: #00000080;
        TouchArea {
            clicked => { root.filter-sheet-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: filter-card-content.preferred-height;
            background: MaterialPalette.surface-container-high;
            border-radius: 28px;

            TouchArea {}

            filter-card-content := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Filter Sessions";
                    font-size: 22px;
                    horizontal-alignment: center;
                    color: MaterialPalette.on-surface;
                }

                // Has Notes toggle — mirrors GTK's
                // `Adw.SwitchRow filter_notes_row { title:
                // _("Has Notes"); }` at
                // `meditate-gtk/data/ui/window.blp:102`. Instant
                // apply: flipping the switch fires
                // `filter-notes-toggled`, Rust reloads page 0
                // with the new filter and closes the sheet (the
                // Label chooser row lands in L-5c).
                BoxedList {
                    SwitchRow {
                        title: "Has Notes";
                        subtitle: "Only sessions with a note";
                        checked <=> root.filter-notes-only;
                        toggled(on) => { root.filter-notes-toggled(on); }
                    }
                }

                // Label filter dropdown — Material's ComboRow
                // analogue. Index 0 is the synthetic "All labels"
                // entry (clears the filter). Instant-apply: a
                // pick fires `filter-label-selected`, Rust
                // reloads + closes the sheet, matching GTK's
                // `filter_label_row` notify handler at
                // `meditate-gtk/src/window/imp.rs:799`.
                DropDownMenu {
                    label: "Label";
                    items: root.filter-label-items;
                    current-index <=> root.filter-label-index;
                    selected(idx) => { root.filter-label-selected(idx); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    TextButton {
                        text: "Close";
                        clicked => { root.filter-sheet-open = false; }
                    }
                }
            }
        }
    }

    // ── Top AppBar — title + Preferences trigger ────────────────
    // Pinned at y=0 on the base pages (Setup, Log). Hidden when
    // any overlay (Running / Done / Labels) is up — those
    // destinations are full-window and don't need the app
    // chrome. Trailing `Icons.menu` is a placeholder for the
    // future Preferences page (phase 7 work).
    //
    // The outer Rectangle reserves `status-bar-inset` of vertical
    // space above the AppBar so the notch / system clock /
    // battery icons don't crash into the title or Preferences
    // button. Background extends behind that zone too (surface
    // colour) so the status bar reads against a matching tint.
    Rectangle {
        visible: !root.running-page && !root.done-page && !root.labels-page && !root.edit-session-page;
        x: 0;
        y: 0;
        width: parent.width;
        height: root.status-bar-inset + root.header-bar-height;
        background: MaterialPalette.surface-container;

        // Hand-rolled left-aligned bar (replaces Material's
        // `SmallAppBar`): the catalog wrapper doesn't expose
        // `text_padding`, so its title sits ~4 px from the left
        // edge, and its `trailing-buttons` only accepts an array
        // value — an `if`-branched conditional array literal
        // wouldn't type-check, so we couldn't hide the funnel
        // outright (only dim it) via that path.
        //
        // Mirrors `SmallAppBar` visually (surface-container
        // background, 22 sp title in `on-surface`, IconButton
        // trailing children) but adds a 16 px title inset and
        // gates the funnel on `nav-page == 1` so it only appears
        // on the Log page. Mirrors GTK's window header at
        // `meditate-gtk/data/ui/window.blp:87` where
        // `log_filter_btn` is `visible: false` until the Log
        // view is selected.
        Rectangle {
            x: 0;
            y: root.status-bar-inset;
            width: 100%;
            height: root.header-bar-height;
            background: MaterialPalette.surface-container;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 4px;
                spacing: 4px;
                alignment: stretch;

                Text {
                    text: "Meditate";
                    font-size: 22px;
                    font-weight: 400;
                    color: MaterialPalette.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    overflow: elide;
                }
                // Sync-status indicator — trailing side, before
                // the funnel, matching GTK's `[end]` placement of
                // `sync_status_btn` alongside the filter button.
                // Not rendered in the Hidden state (no account).
                if root.sync-indicator-state != 0 : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;

                        sync-touch := TouchArea {
                            clicked => { root.sync-indicator-tap(); }
                        }

                        if root.sync-indicator-state == 1 : CircularProgressIndicator {
                            width: 22px;
                            height: 22px;
                            indeterminate: true;
                        }
                        if root.sync-indicator-state == 2 : Image {
                            source: @image-url("assets/warning.svg");
                            colorize: MaterialPalette.error;
                            width: 22px;
                            height: 22px;
                        }
                        if root.sync-indicator-state == 3 : Image {
                            source: Icons.check;
                            colorize: MaterialPalette.primary;
                            width: 22px;
                            height: 22px;
                        }
                    }
                }
                if root.nav-page == 1 : VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("assets/filter.svg");
                        clicked => { root.log-filter-tap(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.menu;
                        clicked => { root.preferences-tap(); }
                    }
                }
            }
        }
    }

    // ── Undo snackbar — Material 3 analogue of GTK's adw::Toast ─
    // Visible only while a delete is pending; Rust toggles
    // `snackbar-visible` true on delete-tap, sets a 5 s timer,
    // and toggles back to false from either the timer firing
    // (commit deletes) or the Undo tap (restore hidden cards).
    // The text is the rendered "N sessions deleted" string —
    // Rust formats it via `meditate_core::announcement::
    // Announcement::SessionDeleted { count }`.
    //
    // Visual recipe matches `material-1.0/ui/components/
    // snack_bar.slint`: inverse-surface background, 4 px radius,
    // 344 px max width, level-3 elevation (simulated with a
    // single drop shadow since composing `Elevation` inside an
    // `if` block is awkward), 16 px / 10 px padding, inverse text
    // colour, inline TextButton with `inverse: true` so the
    // accent reads on the dark surface.
    //
    // Parking position: above the NavigationBar by 12 px, with
    // the bottom-bar-inset under it so the snackbar sits clear of
    // the gesture hint when the NavigationBar is hidden during an
    // overlay (though we currently only show the snackbar on the
    // Log page, which always has the NavigationBar visible).
    if root.snackbar-visible : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - root.nav-bar-height - root.bottom-bar-inset - self.height - 12px;
        width: min(parent.width - 24px, 344px);
        height: 60px;
        border-radius: 4px;
        background: MaterialPalette.inverse-surface;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 2px;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            spacing: 4px;
            alignment: stretch;

            Text {
                text: root.snackbar-text;
                font-size: 14px;
                color: MaterialPalette.inverse-on-surface;
                vertical-alignment: center;
                horizontal-alignment: left;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            // TextButton's BaseButton internals add their own 10 px
            // top/bottom padding and a `min_height: 40px`, so wrap
            // it in a VerticalLayout-centered cell instead of
            // letting the outer HorizontalLayout vertically stretch
            // it — the stretch was clipping the bottom of the
            // "Undo" glyphs even at 72 px snackbar height. With
            // `alignment: center` the button sits at its preferred
            // 40 px height inside the 60 px container, with 10 px
            // of breathing room above and below.
            VerticalLayout {
                alignment: center;
                TextButton {
                    text: "Undo";
                    inverse: true;
                    clicked => { root.snackbar-undo-tap(); }
                }
            }
        }
    }

    // ── Bottom NavigationBar — visible on base pages only ───────
    // Pinned at y = parent.height - nav-bar-height. Hidden
    // during full-window overlays (Running / Done / Labels) so
    // the user can't accidentally nav-switch mid-session or
    // mid-edit. Selecting an item updates `nav-page` (in-out)
    // and fires `nav-changed` so Rust can refresh per-page
    // state (e.g. reload the Log feed when entering it).
    Rectangle {
        visible: !root.running-page && !root.done-page && !root.labels-page && !root.edit-session-page;
        x: 0;
        y: parent.height - root.nav-bar-height - root.bottom-bar-inset;
        width: parent.width;
        height: root.nav-bar-height + root.bottom-bar-inset;
        // Background extends across the bottom inset so the
        // strip below the NavigationBar reads as part of the
        // bar rather than a gap to the screen edge.
        background: MaterialPalette.surface-container;

        NavigationBar {
            x: 0;
            y: 0;
            width: 100%;
            height: root.nav-bar-height;
            items: [
                {
                    icon: Icons.schedule,
                    selected-icon: Icons.schedule,
                    text: "Timer",
                },
                {
                    icon: Icons.calendar-today,
                    selected-icon: Icons.calendar-today,
                    text: "Log",
                },
            ];
            current-index <=> root.nav-page;
            index-changed(idx) => { root.nav-changed(idx); }
        }
    }
    } // root-focus FocusScope
}
